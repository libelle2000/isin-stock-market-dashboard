{
  "name": "isin-stock-market-dashboard",
  "version": "1.0.0",
  "description": "Stock market dashboard application for tracking ISINs and visualizing buy/sell events",
  "main": "dist/endpoint/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/endpoint/index.js",
    "dev": "ts-node src/endpoint/index.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "remove-unused-imports": "eslint --fix --quiet \"src/**/*.{ts,tsx}\" --rule \"unused-imports/no-unused-imports: error\""
  },
  "dependencies": {
    "ajv": "^8.12.0",
    "axios": "^1.6.2",
    "csv-parser": "^3.0.0",
    "dinero.js": "^2.0.0-alpha.14",
    "express": "^4.18.2",
    "fs-extra": "^11.1.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^29.5.10",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^8.35.0",
    "@typescript-eslint/parser": "^8.35.0",
    "eslint": "^9.30.0",
    "eslint-plugin-unused-imports": "^4.1.4",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.2"
  }
}
